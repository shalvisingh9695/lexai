# Google Gemini API Key (Required for live embeddings and AI synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (Falls back automatically to in-memory store if omitted/unreachable)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lexai?retryWrites=true&w=majority

# Port (Render injects this dynamically in production)
PORT=10000

# Node Environment
NODE_ENV=production
